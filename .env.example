# Variables de entorno para las Netlify Functions (NO subir el .env real al repo).
# En producción se configuran en Netlify: Site settings -> Environment variables.

# ---------- MERCADO PAGO (el dinero entra a la cuenta dueña de este token) ----------
# Sacar con la cuenta de MP del DUEÑO en https://www.mercadopago.com.ar/developers
# -> Tus integraciones -> crear aplicación -> Credenciales de PRODUCCIÓN -> Access Token
# Empieza con APP_USR-...
MP_ACCESS_TOKEN=

# ---------- SUPABASE ----------
# Secret key del proyecto (Dashboard -> Project Settings -> API keys -> secret).
# Necesaria para crear/activar gift cards salteando el RLS.
SUPABASE_SERVICE_KEY=

# ---------- EMAIL (opción recomendada: Gmail de la barbería) ----------
# Requiere en la cuenta de Gmail: verificación en 2 pasos activada +
# contraseña de aplicación generada en https://myaccount.google.com/apppasswords
GMAIL_USER=bsasbarbershop@gmail.com
GMAIL_APP_PASSWORD=

# ---------- EMAIL (fallback: Resend, solo si no se configura Gmail) ----------
# Clave secreta de Resend (empieza con re_...). Se saca en https://resend.com/api-keys
RESEND_API_KEY=
# En producción con dominio verificado: "Buenos Aires Barbershop <regalos@buenosairesbarbershop.com>"
RESEND_FROM=Buenos Aires Barbershop <onboarding@resend.dev>

# ---------- OPCIONAL ----------
# URL pública del sitio (para los back_urls y el webhook de MP)
SITE_URL=
