# Variables de entorno para las Netlify Functions (NO subir el .env real al repo).
# Copiá este archivo como ".env" y completá los valores.

# Clave secreta de Resend (empieza con re_...). Se saca en https://resend.com/api-keys
RESEND_API_KEY=

# Remitente. En modo prueba dejá el de Resend (solo envía a tu propio mail).
# En producción: "Buenos Aires Barbershop <regalos@buenosairesbarbershop.com>"
RESEND_FROM=Buenos Aires Barbershop <onboarding@resend.dev>
